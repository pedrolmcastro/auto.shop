{
  "files.associations": {
    ".yamllint": "yaml"
  },
  "gradle.nestedProjects": true,
  "java.checkstyle.version": "14.3.0",
  "java.checkstyle.configuration": "${workspaceFolder}/api/config/checkstyle/checkstyle.xml",
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.format.settings.profile": "auto.shop Checkstyle",
  "java.format.settings.url": "api/config/formatter/java-formatter.xml",
  "sonarlint.connectedMode.project": {
    "connectionId": "pedrolmcastro",
    "projectKey": "pedrolmcastro_auto.shop"
  },
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  }
}
