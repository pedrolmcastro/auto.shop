---
extends: default
rules:
  anchors:
    forbid-duplicated-anchors: true
    forbid-unused-anchors: true
  comments:
    min-spaces-from-content: 1
  empty-values: enable
  key-ordering: enable
  line-length:
    allow-non-breakable-words: true
    max: 120
  octal-values: enable
  quoted-strings:
    quote-type: single
    required: only-when-needed
